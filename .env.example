# Create an API key and verify a sender domain with Resend: https://resend.com/
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=TKS Website <website@your-verified-domain.com>
TKS_ENQUIRY_TO=tksengneering2004@gmail.com

# Used by prerender-routes.mjs. Set this to the canonical public origin on deployment.
PUBLIC_SITE_URL=https://tksengworks.com
# Local builds default to noindex. Vercel Production is indexable unless explicitly set to false;
# Preview is always noindex. For non-Vercel production builds, set this to true deliberately.
VITE_INDEXABLE=
